# Supabase (Optional - remove if not using backend)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Service role key (PROJ-22) — Supabase Dashboard → Project Settings → API → service_role secret.
# Bypasses RLS entirely; used server-side only, to invite new teacher accounts. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Base URL used to build Supabase auth email links (confirmation, password reset)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SEPA-Sammellastschrift (PROJ-7) — Gläubiger-Stammdaten für die pain.008-XML-Erzeugung
SEPA_CREDITOR_NAME=Vienna Salsa Studio
SEPA_CREDITOR_IBAN=your_studio_iban_here
SEPA_CREDITOR_ID=your_glaeubiger_id_here
# Optional — wenn gesetzt, wird die BIC statt "NOTPROVIDED" in die XML geschrieben
# SEPA_CREDITOR_BIC=your_bic_here

# Web Push (PROJ-16) — VAPID-Schlüsselpaar, einmalig generiert mit `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:info@viennasalsastudio.at

# SMTP (PROJ-16) — Zugangsdaten der Studio-Mailadresse, vom Betreiber vor /deploy bereitzustellen
# SMTP_HOST=smtp.sendgrid.net
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password

# Add more environment variables as needed
