# Supabase (Optional - remove if not using backend)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Base URL used to build Supabase auth email links (confirmation, password reset)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SEPA-Sammellastschrift (PROJ-7) — Gläubiger-Stammdaten für die pain.008-XML-Erzeugung
SEPA_CREDITOR_NAME=Vienna Salsa Studio
SEPA_CREDITOR_IBAN=your_studio_iban_here
SEPA_CREDITOR_ID=your_glaeubiger_id_here
# Optional — wenn gesetzt, wird die BIC statt "NOTPROVIDED" in die XML geschrieben
# SEPA_CREDITOR_BIC=your_bic_here

# Add more environment variables as needed
# SMTP_HOST=smtp.sendgrid.net
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password
